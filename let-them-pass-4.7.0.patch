+static bool canYieldInTraffic(const DROID *droid)
+{
+	return !bMultiPlayer && droid->player == selectedPlayer && !droid->died
+	       && droid->order.type == DORDER_MOVE && droid->action == DACTION_MOVE
+	       && (droid->sMove.Status == MOVEPOINTTOPOINT || droid->sMove.Status == MOVEPAUSE)
+	       && droid->getPropulsionStats()->propulsionType != PROPULSION_TYPE_LIFT
+	       && !droid->isTransporter();
