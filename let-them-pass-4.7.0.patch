+static void moveRecoverOrphanedPause(DROID *droid, bool yielding)
+{
+	auto &move = droid->sMove;
+	auto &traffic = move.friendlyTraffic;
+	const Vector2i position = droid->pos.xy();
+	if (traffic.wakeAttempts != 0 && iHypot(position - traffic.wakePosition) >= TILE_UNITS / 2)
+	{
+		traffic.wakeAttempts = 0;
+	}
+	if (yielding || move.Status != MOVEPAUSE || move.bumpTime != 0 || !canYieldInTraffic(droid))
+	{
+		traffic.wakeDelay = 0;
+		return;
+	}
+
+	// A normal pause is released by the bump timer. With no bump, it needs its own retry.
+	if (traffic.wakeDelay == 0)
+	{
+		const unsigned maxDelay = std::min(800u << traffic.wakeAttempts, 2000u);
+		uint32_t seed = droid->id * 0x9e3779b9u ^ gameTime;
+		seed ^= seed >> 16;
+		seed *= 0x7feb352du;
+		seed ^= seed >> 15;
+		traffic.wakeStart = gameTime;
+		traffic.wakeDelay = 200u + seed % (maxDelay - 200u + 1u);
+		traffic.wakePosition = position;
+	}
+	if (gameTime - traffic.wakeStart >= traffic.wakeDelay)
+	{
+		debug(LOG_INFO, "Friendly traffic: droid %u resumed a paused move after %u ms without a bump timer",
+		      droid->id, gameTime - traffic.wakeStart);
+		traffic.wakeDelay = 0;
+		traffic.wakeAttempts = std::min(traffic.wakeAttempts + 1, 2u);
+		move.Status = MOVEPOINTTOPOINT;
+	}
+}
+
+static Vector2i trafficHeading(const DROID *droid)
+{
+	const auto &move = droid->sMove;
+	const Vector2i position = droid->pos.xy();
+	for (size_t i = std::max(0, move.pathIndex - 1); i < move.asPath.size(); ++i)
+	{
+		const Vector2i heading = move.asPath[i] - position;
+		if (iHypot(heading) >= 5 * TILE_UNITS)
+		{
+			return heading;
+		}
+	}
+	return move.destination - position;
+}
+
+static int trafficDistanceToExit(const DROID *droid, const Vector2i &center)
+{
+	const auto &move = droid->sMove;
+	for (size_t i = std::max(0, move.pathIndex - 1); i < move.asPath.size(); ++i)
+	{
+		if (iHypot(move.asPath[i] - center) >= 2 * TILE_UNITS)
+		{
+			return iHypot(move.asPath[i] - droid->pos.xy());
+		}
+	}
+	return iHypot(move.destination - droid->pos.xy());
+}
+
+static void noticeFriendlyTraffic(const DROID *droid, const DROID *other)
+{
+	if (!canYieldInTraffic(droid) || !canYieldInTraffic(other)
+	    || droid->sMove.friendlyTraffic.progressTime == 0
+	    || other->sMove.friendlyTraffic.progressTime == 0
+	    || gameTime - droid->sMove.friendlyTraffic.progressTime < TRAFFIC_STALL_TIME
+	    || gameTime - other->sMove.friendlyTraffic.progressTime < TRAFFIC_STALL_TIME
+	    || dot(trafficHeading(droid), trafficHeading(other)) >= 0)
+	{
+		return;
+	}
+
+	const Vector2i center = (droid->pos.xy() + other->pos.xy()) / 2;
+	const FriendlyTrafficConflict *previous = nullptr;
+	for (const auto &conflict : friendlyTrafficConflicts)
+	{
+		const int separation = iHypot(conflict.center - center);
+		if (separation <= TRAFFIC_RADIUS && conflict.endTime == 0)
+		{
+			return;
+		}
+		if (separation <= 5 * TILE_UNITS && conflict.endTime != 0 && (!previous || conflict.endTime > previous->endTime))
+		{
+			previous = &conflict;
+		}
+	}
+	const int distance = trafficDistanceToExit(droid, center);
+	const int otherDistance = trafficDistanceToExit(other, center);
+	const DROID *priority = (distance < otherDistance || (distance == otherDistance && droid->id < other->id)) ? droid : other;
+	if (previous && abs(angleDelta(iAtan2(trafficHeading(priority)) - previous->priorityDirection)) <= DEG(90))
+	{
+		// A recurring conflict gives the previous yielding line the next turn.
+		priority = priority == droid ? other : droid;
+	}
+	friendlyTrafficConflicts.push_back({center, static_cast<uint16_t>(iAtan2(trafficHeading(priority))), ++friendlyTrafficConflictId,
+	                                   gameTime, gameTime + 2 * TRAFFIC_STALL_TIME});
+	debug(LOG_INFO, "Friendly traffic: droids %u and %u stalled at (%d,%d); droid %u has right of way",
+	      droid->id, other->id, map_coord(center.x), map_coord(center.y), priority->id);
+}
+
+static bool trafficHeadsAgainst(const DROID *droid, const FriendlyTrafficConflict &conflict)
+{
+	return abs(angleDelta(iAtan2(trafficHeading(droid)) - conflict.priorityDirection)) > DEG(90);
+}
+
+static void updateFriendlyTrafficConflicts()
+{
+	if (friendlyTrafficUpdateTime == gameTime)
+	{
+		return;
+	}
+	friendlyTrafficUpdateTime = gameTime;
+	friendlyTrafficConflicts.erase(std::remove_if(friendlyTrafficConflicts.begin(), friendlyTrafficConflicts.end(),
+		[](FriendlyTrafficConflict &conflict) {
+			if (gameTime < conflict.startTime)
+			{
+				return true;
+			}
+			if (conflict.endTime != 0)
+			{
+				return gameTime - conflict.endTime >= TRAFFIC_PRIORITY_MEMORY;
+			}
+			if (gameTime - conflict.startTime >= TRAFFIC_MAX_HOLD)
+			{
+				conflict.endTime = gameTime;
+				return false;
+			}
+			if (gameTime < conflict.nextCheck)
+			{
+				return false;
+			}
+			conflict.nextCheck = gameTime + TRAFFIC_CHECK_INTERVAL;
+			for (BASE_OBJECT *object : gridStartIterate(conflict.center.x, conflict.center.y, 5 * TILE_UNITS))
+			{
+				const DROID *droid = castDroid(object);
+				if (droid && canYieldInTraffic(droid) && !trafficHeadsAgainst(droid, conflict))
+				{
+					return false;
+				}
+			}
+			conflict.endTime = gameTime;
+			return false;
+		}), friendlyTrafficConflicts.end());
+}
+
+static bool trafficUsesPassage(const DROID *droid, const Vector2i &center)
+{
+	constexpr int passageRadius = 4 * TILE_UNITS;
+	const auto &move = droid->sMove;
+	if (iHypot(droid->pos.xy() - center) <= passageRadius)
+	{
+		return true;
+	}
+	const auto start = std::min<size_t>(std::max(0, move.pathIndex - 1), move.asPath.size());
+	const auto end = std::min(start + 2 * TRAFFIC_RADIUS / TILE_UNITS, move.asPath.size());
+	return std::any_of(move.asPath.begin() + start, move.asPath.begin() + end,
+	                   [&center](const Vector2i &waypoint) { return iHypot(waypoint - center) <= passageRadius; });
+}
+
+static bool trafficLineClear(DROID *droid, const Vector2i &target, const GridList &nearby)
+{
+	const Vector2i start = droid->pos.xy();
+	const auto propulsion = droid->getPropulsionStats()->propulsionType;
+	if (target == start || !worldOnMap(target.x, target.y) || fpathBlockingTile(map_coord(target.x), map_coord(target.y), propulsion))
+	{
+		return false;
+	}
+
+	BLOCKING_CALLBACK_DATA data;
+	data.propulsionType = propulsion;
+	data.blocking = false;
+	data.src = start;
+	data.dst = target;
+	rayCast(start, target, &moveBlockingTileCallback, &data);
+	if (data.blocking)
+	{
+		return false;
+	}
+
+	const Vector2i line = target - start;
+	const int64_t lengthSq = dot(line, line);
+	for (BASE_OBJECT *object : nearby)
+	{
+		const DROID *other = castDroid(object);
+		if (!other || other == droid || other->died || other->isFlying())
+		{
+			continue;
+		}
+		const Vector2i offset = other->pos.xy() - start;
+		const int64_t projection = dot(offset, line);
+		const int64_t clearance = moveObjRadius(droid) + moveObjRadius(other);
+		if (projection <= 0)
+		{
+			continue; // Allow movement away from a droid we already touch.
+		}
+		if (projection >= lengthSq)
+		{
+			if (iHypot(other->pos.xy() - target) < clearance)
+			{
+				return false;
+			}
+			continue;
+		}
+		const int64_t cross = int64_t(line.x) * offset.y - int64_t(line.y) * offset.x;
+		if (cross * cross < clearance * clearance * lengthSq)
+		{
+			return false;
+		}
+	}
+	return true;
+}
+
+static std::optional<Vector2i> findFriendlyTrafficTarget(DROID *droid, const FriendlyTrafficConflict &conflict, bool &detour)
+{
+	const Vector2i start = droid->pos.xy();
+	const GridList nearby = gridStartIterate(start.x, start.y, 5 * TILE_UNITS);
+	const auto direction = uint16_t(conflict.priorityDirection + DEG(180));
+	const Vector2i forward = iSinCosR(direction, 2 * TILE_UNITS);
+	const Vector2i side = iSinCosR(direction + DEG(90), TILE_UNITS);
+
+	// A clear short bypass costs less than backing a line of droids out.
+	for (const int lane : {1, -1, 2, -2})
+	{
+		const Vector2i target = start + forward + side * lane;
+		if (dot(start - conflict.center, forward) < 0 && dot(target - conflict.center, forward) >= TILE_UNITS * TILE_UNITS
+		    && trafficLineClear(droid, target, nearby))
+		{
+			detour = true;
+			return target;
+		}
+	}
+
+	// At an opening, make room next to the lane and let the other line pass.
+	for (const int lane : {1, -1, 2, -2})
+	{
+		const Vector2i target = start - forward / 4 + side * lane;
+		if (abs(dot(target - conflict.center, side)) >= 2 * TILE_UNITS * TILE_UNITS
+		    && abs(dot(target - conflict.center, side)) > abs(dot(start - conflict.center, side))
+		    && trafficLineClear(droid, target, nearby))
+		{
+			return target;
+		}
+	}
+
+	// Walk back along the original route when that stretch is still clear.
+	const auto &move = droid->sMove;
+	for (int i = std::min(move.pathIndex - 1, static_cast<int>(move.asPath.size()) - 1); i >= 0; --i)
+	{
+		const Vector2i target = move.asPath[i];
+		const Vector2i delta = target - start;
+		const int distance = iHypot(delta);
+		if (distance > 3 * TILE_UNITS)
+		{
+			break;
+		}
+		if (distance >= TILE_UNITS / 2 && dot(delta, forward) < 0 && trafficLineClear(droid, target, nearby))
+		{
+			return target;
+		}
+	}
+
+	// A route may have been recalculated from the jam itself. Try a short retreat or pullout.
+	for (const int lane : {0, 1, -1})
+	{
+		const Vector2i target = start - forward / 2 + side * lane;
+		if (trafficLineClear(droid, target, nearby))
+		{
+			return target;
+		}
+	}
+	return std::nullopt;
+}
+
+static std::optional<Vector2i> friendlyTrafficSteering(DROID *droid)
+{
+	if (!canYieldInTraffic(droid))
+	{
+		return std::nullopt;
+	}
+	auto &state = droid->sMove.friendlyTraffic;
+	const Vector2i pos = droid->pos.xy();
+	if (state.progressTime == 0 || iHypot(pos - state.progressPosition) >= TILE_UNITS / 2)
+	{
+		state.progressPosition = pos;
+		state.progressTime = gameTime;
+	}
+	updateFriendlyTrafficConflicts();
+	for (const auto &conflict : friendlyTrafficConflicts)
+	{
+		if (conflict.endTime != 0 || state.orderTime >= conflict.startTime)
+		{
+			continue;
+		}
+		if (state.maneuver != conflict.id)
+		{
+			if (iHypot(pos - conflict.center) > TRAFFIC_RADIUS || !trafficHeadsAgainst(droid, conflict)
+			    || !trafficUsesPassage(droid, conflict.center))
+			{
+				continue;
+			}
+			state.maneuver = conflict.id;
+			state.nextAttempt = 0;
+			state.target = {-1, -1};
+			state.detour = false;
+			state.detourComplete = false;
+		}
+		if (state.detourComplete)
+		{
+			return std::nullopt;
+		}
+		if (state.target.x >= 0 && iHypot(state.target - pos) <= TILE_UNITS / 4)
+		{
+			state.detourComplete = state.detour;
+			if (state.detourComplete)
+			{
+				if (!droid->sMove.asPath.empty())
+				{
+					moveBestTarget(droid);
+				}
+				return std::nullopt;
+			}
+			// A unit along the lane must keep retreating. Stop in a shoulder or beyond the queue.
+			const Vector2i side = iSinCosR(conflict.priorityDirection + DEG(90), TILE_UNITS);
+			if (abs(dot(pos - conflict.center, side)) >= 2 * TILE_UNITS * TILE_UNITS
+			    || iHypot(pos - conflict.center) >= TRAFFIC_RADIUS)
+			{
+				return pos;
+			}
+			state.target = {-1, -1};
+		}
+		if (gameTime >= state.nextAttempt)
+		{
+			state.nextAttempt = gameTime + TRAFFIC_CHECK_INTERVAL;
+			if (state.target.x < 0 || gameTime - state.progressTime >= TRAFFIC_STALL_TIME)
+			{
+				state.detour = false;
+				state.target = findFriendlyTrafficTarget(droid, conflict, state.detour).value_or(Vector2i(-1, -1));
+				state.progressPosition = pos;
+				state.progressTime = gameTime;
+			}
+		}
+		return state.target.x < 0 ? pos : state.target;
+	}
+	return std::nullopt;
+}
